{
  "name": "stickman-fighter",
  "version": "1.6.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server/start.mjs",
    "start": "node server/start.mjs",
    "dev:client": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run generate:spin-poses -- --check && npm run generate:spin-boxes -- --check && npm run generate:strike-boxes -- --check && npm run generate:walk -- --check && npm run generate:tornado -- --check && npm run generate:uppercut -- --check && npm run generate:contacts -- --check && npm run build",
    "generate:spin-boxes": "node scripts/generate-spin-boxes.mjs",
    "generate:strike-boxes": "node scripts/generate-strike-boxes.mjs",
    "generate:walk": "python scripts/generate-walk-poses.py",
    "generate:tornado": "node scripts/generate-tornado-combo.mjs",
    "generate:spin-poses": "python scripts/generate-spin-poses.py",
    "cpu:tournament": "node scripts/cpu-tournament.mjs",
    "generate:uppercut": "node scripts/generate-jumping-uppercut.mjs",
    "generate:contacts": "node scripts/generate-contact-geometry.mjs"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vite": "8.3.0"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  }
}
